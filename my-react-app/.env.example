# Frontend API base URL.
# Leave empty in local development because Vite proxies /api and /uploads to the Python backend.
# For the production Firebase Hosting build, set this to the Render backend URL, e.g.:
# VITE_API_BASE_URL=https://mahalxmi-api.onrender.com
VITE_API_BASE_URL=
VITE_GOOGLE_CLIENT_ID=

# Dev-server only (not part of the bundle): where the Vite proxy sends /api and /uploads.
# Defaults to http://127.0.0.1:8000 — set it only if the backend runs on another port/host.
VITE_BACKEND_URL=
