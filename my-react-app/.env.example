# ============================================================================
# MAHALAXMI MULTI CUISINE — FEEDBACK & CASHBACK SYSTEM
# Copy this file to `.env` and fill in the values to enable Firebase mode.
# ----------------------------------------------------------------------------
# If VITE_FIREBASE_PROJECT_ID is left EMPTY, the app automatically runs in
# LOCAL DEMO MODE (browser localStorage) so you can try the full flow without
# any setup. Demo mode is NOT for production — use Firebase for real use.
# ============================================================================

# --- Firebase project config (Firebase Console → Project settings) ---------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Admin portal route (non-obvious path; default shown below) -------------
VITE_ADMIN_ROUTE=/admin-portal-private
