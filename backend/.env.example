# Copy this file to backend/.env — it is loaded automatically at startup
# (real environment variables always win over this file).

# --- Required in production (APP_ENV=production) ---------------------------
# The server refuses to boot in production without these three values.
# APP_ENV=production
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=your-strong-admin-password
# SESSION_SECRET=generate-a-long-random-string-here

# --- Optional --------------------------------------------------------------
# Google admin sign-in (also enable VITE_GOOGLE_CLIENT_ID in the frontend)
# GOOGLE_CLIENT_ID=1234567890-xxxx.apps.googleusercontent.com

# Admin bearer-token lifetime in hours (default 24)
# ADMIN_TOKEN_TTL_HOURS=24

# Allowed cross-origin frontends in production, comma-separated (empty =
# same-origin only). Set this to your Firebase Hosting domain(s), e.g.:
# CORS_ORIGINS=https://your-project.web.app,https://your-project.firebaseapp.com
