# Copy this file to backend/.env — it is loaded automatically at startup
# (real environment variables always win over this file).

# --- Required in production (APP_ENV=production) ---------------------------
# The server refuses to boot in production without these three values.
# APP_ENV=production
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=your-strong-admin-password
# SESSION_SECRET=generate-a-long-random-string-here

# --- Backend mode -----------------------------------------------------------
# local    = SQLite + backend/uploads/   (zero-config development)
# firebase = Cloud Firestore + Firebase Storage (Cloud Run production)
# Unset: auto-detects — firebase on Cloud Run (K_SERVICE present), else local.
# BACKEND_MODE=local

# Firebase mode only — optional overrides. Normally auto-detected:
# FIREBASE_PROJECT_ID=mahalxmi-review-system
# FIREBASE_STORAGE_BUCKET=mahalxmi-review-system.appspot.com
# Locally, firebase mode additionally needs Application Default Credentials:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# --- Optional --------------------------------------------------------------
# Google admin sign-in (also enable VITE_GOOGLE_CLIENT_ID in the frontend)
# GOOGLE_CLIENT_ID=1234567890-xxxx.apps.googleusercontent.com

# Admin bearer-token lifetime in hours (default 24)
# ADMIN_TOKEN_TTL_HOURS=24

# Allowed cross-origin frontends in production, comma-separated (empty =
# same-origin only). Set this to your Firebase Hosting domain(s), e.g.:
# CORS_ORIGINS=https://your-project.web.app,https://your-project.firebaseapp.com

# --- Image storage (independent of database mode) ----------------------------
# New uploads default to Cloudinary. Keep BACKEND_MODE=local for existing SQLite.
# Set IMAGE_STORAGE=local explicitly only for offline development/tests.
IMAGE_STORAGE=cloudinary
CLOUDINARY_CLOUD_NAME=n7m4rzvw
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Never expose these credentials in VITE_* variables or commit backend/.env.
# Cloudinary URLs are directly deliverable to anyone who possesses the URL.
# Cloudinary asset deletion is disabled in this initial migration.
